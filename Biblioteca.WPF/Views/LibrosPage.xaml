<Page x:Class="Biblioteca.WPF.Views.LibrosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Libros"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Libros" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registre, busque y actualice el catalogo. La baja es logica: el libro queda como inactivo."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista de libros -->
            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtSearch" Grid.Column="0" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Buscar por titulo o por autor."
                                    ClearButtonEnabled="True" TextChanged="txtSearch_TextChanged" />
                        <ui:Button x:Name="btnRefresh" Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Actualizar"
                                   Click="btnRefresh_Click" />
                    </Grid>

                    <DataGrid x:Name="dgLibros" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgLibros_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titulo" Binding="{Binding Titulo}" Width="2.5*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding NombreAutor}" Width="2*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="100"
                                                ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTemplateColumn Header="Estado" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ActivoPill}">
                                            <TextBlock Style="{StaticResource ActivoPillText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacio -->
                    <StackPanel x:Name="emptyState" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="Book24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtEmpty" Text="No hay libros." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <!-- Indicador de carga -->
                    <ui:ProgressRing x:Name="busyRing" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- Formulario: registrar o editar -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="8"
                                Margin="0,0,12,0" Background="{StaticResource InfoSoftBrush}">
                            <ui:SymbolIcon x:Name="iconForm" Symbol="BookAdd24" FontSize="18"
                                           Foreground="{StaticResource InfoBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtFormTitle" Text="Nuevo libro" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="txtFormHint" Text="Complete los datos y pulse Guardar."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Titulo" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtTitulo" PlaceholderText="e.g. La ciudad y los perros" MaxLength="150" />

                    <TextBlock Text="ISBN" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtIsbn" PlaceholderText="e.g. 9788437604572" MaxLength="20"
                                Icon="{ui:SymbolIcon BarcodeScanner24}" />

                    <TextBlock Text="Autor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="cboAutores" IsEditable="True" IsTextSearchEnabled="True"
                              TextSearch.TextPath="Nombre" />

                    <TextBlock Text="Ejemplares" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox x:Name="nbEjemplares" PlaceholderText="1" SmallChange="1"
                                  SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnNuevo" Grid.Column="0" Content="Nuevo" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Add24}" ToolTip="Limpiar el formulario (Ctrl+N)"
                                   Click="btnNuevo_Click" />
                        <ui:Button x:Name="btnGuardar" Grid.Column="2" Content="Guardar" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" ToolTip="Guardar (Ctrl+S)"
                                   Click="btnGuardar_Click" />
                    </Grid>
                    <ui:Button x:Name="btnDarDeBaja" Content="Dar de baja" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Click="btnDarDeBaja_Click" />

                    <TextBlock Margin="0,20,0,0" Style="{StaticResource HintText}"
                               Text="Reglas: el ISBN no se repite y no se puede dar de baja un libro prestado." />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}"
                               Text="Atajos: Ctrl+N nuevo - Ctrl+S guardar - Esc cancelar edicion" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
