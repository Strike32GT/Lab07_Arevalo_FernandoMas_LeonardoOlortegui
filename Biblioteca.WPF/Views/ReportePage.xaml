<Page x:Class="Biblioteca.WPF.Views.ReportePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reporte"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reporte de prestamos" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Consulta por intervalo de fechas de prestamo. El dato sale de un INNER JOIN entre Prestamos, DetallePrestamo, Libros y Socios."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Filtros -->
        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DatePicker x:Name="dpDesde" Width="150" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DatePicker x:Name="dpHasta" Width="150" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Resultado" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <TextBlock x:Name="txtTotal" Text="0 filas" FontWeight="SemiBold" Margin="0,0,0,8" />
                </StackPanel>
                <ui:Button x:Name="btnConsultar" Grid.Column="3" VerticalAlignment="Bottom" Padding="12,8"
                           Content="Consultar" Icon="{ui:SymbolIcon Search24}"
                           Click="btnConsultar_Click" />
                <ui:Button x:Name="btnLimpiar" Grid.Column="5" VerticalAlignment="Bottom" Padding="10"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Limpiar filtros"
                           Click="btnLimpiar_Click" />
            </Grid>
        </ui:Card>

        <!-- Tabla de resultados -->
        <ui:Card Grid.Row="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Detalle de los prestamos del intervalo" Margin="4,0,0,12"
                           Style="{StaticResource SectionTitle}" />

                <DataGrid x:Name="dgReporte" Grid.Row="1" Style="{StaticResource ModernGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="100"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="2.5*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha prestamo" Width="130"
                                            Binding="{Binding FechaPrestamo, StringFormat={}{0:dd/MM/yyyy}}"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha limite" Width="130"
                                            Binding="{Binding FechaLimite, StringFormat={}{0:dd/MM/yyyy}}"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EstadoPill}">
                                        <TextBlock Style="{StaticResource EstadoPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Estado vacio -->
                <StackPanel x:Name="emptyState" Grid.Row="1" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="txtEmpty" Text="No hay prestamos en el intervalo seleccionado."
                               Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                </StackPanel>

                <!-- Indicador de carga -->
                <ui:ProgressRing x:Name="busyRing" Grid.Row="1" IsIndeterminate="True"
                                 Width="48" Height="48" Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
