<ui:FluentWindow x:Class="Biblioteca.WPF.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Biblioteca.WPF.Views"
                 Title="Biblioteca" Width="1340" Height="840" MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de titulo propia (estilo Windows 11) con boton para cambiar el tema -->
        <ui:TitleBar Grid.Row="0" Title="Biblioteca - Prestamos y devoluciones"
                     Icon="{ui:SymbolIcon BookOpen24}">
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="btnTheme" Appearance="Transparent" BorderThickness="0"
                           Padding="10,6" Margin="0,0,8,0" ToolTip="Cambiar tema claro / oscuro"
                           Icon="{ui:SymbolIcon WeatherMoon24}" Click="btnTheme_Click" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Menu lateral: cada opcion abre una pagina -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left" OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Libros" Icon="{ui:SymbolIcon Book24}"
                                       TargetPageType="{x:Type views:LibrosPage}" />
                <ui:NavigationViewItem Content="Socios" Icon="{ui:SymbolIcon PeopleTeam24}"
                                       TargetPageType="{x:Type views:SociosPage}" />
                <ui:NavigationViewItem Content="Prestamos" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       TargetPageType="{x:Type views:PrestamosPage}" />
                <ui:NavigationViewItem Content="Devoluciones" Icon="{ui:SymbolIcon ArrowUpload24}"
                                       TargetPageType="{x:Type views:DevolucionesPage}" />
                <ui:NavigationViewItem Content="Reporte" Icon="{ui:SymbolIcon DocumentTable24}"
                                       TargetPageType="{x:Type views:ReportePage}" />
            </ui:NavigationView.MenuItems>

            <!-- Las notificaciones (Snackbar) aparecen encima del contenido -->
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Contenedor de los dialogos de confirmacion -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
