<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Ajusta el servidor segun tu instalacion (., localhost, .\SQLEXPRESS, .\SQLEXPRESO, (localdb)\MSSQLLocalDB) -->
    <add name="BibliotecaDB"
         connectionString="Server=.\SQLEXPRESO;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Parametros de negocio. Se leen en Biblioteca.Negocio/ParametrosNegocio.cs.
         Se pueden cambiar sin recompilar. Usar punto como separador decimal (ej. 1.5). -->
    <add key="MaximoLibrosPendientes" value="3" />
    <add key="MultaPorDia" value="1.5" />
    <add key="DiasPrestamo" value="14" />
  </appSettings>
</configuration>
