<Page x:Class="Grades.WPF.Views.GradesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Grades"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Grades" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choose a student to record their scores per course. The average and status are calculated automatically."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Selección del estudiante y su resumen -->
        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource IconBadge}" Background="{StaticResource InfoSoftBrush}">
                    <ui:SymbolIcon Symbol="HatGraduation24" FontSize="22" Foreground="{StaticResource InfoBrush}" />
                </Border>

                <!-- Editable: se puede escribir para buscar por nombre -->
                <ComboBox x:Name="cboStudents" Grid.Column="1" VerticalAlignment="Center"
                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="FullName"
                          SelectionChanged="cboStudents_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Code}" Width="90"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding FullName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Resumen del estudiante elegido (DataContext = Student) -->
                <StackPanel x:Name="studentInfo" Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Courses" Style="{StaticResource HintText}" />
                        <TextBlock x:Name="txtCourseCount" Text="0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Overall average" Style="{StaticResource HintText}" />
                        <TextBlock Text="{Binding OverallAverage, StringFormat=0.00}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource StatusPill}">
                            <TextBlock Style="{StaticResource StatusPillText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Notas del estudiante -->
            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Courses" Margin="4,0,0,12" Style="{StaticResource SectionTitle}" />

                    <DataGrid x:Name="dgGrades" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgGrades_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Course" Binding="{Binding Course}" Width="*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Score 1" Binding="{Binding Score1, StringFormat=0.##}"
                                                Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Score 2" Binding="{Binding Score2, StringFormat=0.##}"
                                                Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Score 3" Binding="{Binding Score3, StringFormat=0.##}"
                                                Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat=0.00}"
                                                Width="90" FontWeight="SemiBold" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}">
                                            <TextBlock Style="{StaticResource StatusPillText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío -->
                    <StackPanel x:Name="emptyState" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtEmpty" Text="Select a student to see their grades." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <!-- Indicador de carga -->
                    <ui:ProgressRing x:Name="busyRing" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- Formulario de la nota -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="8"
                                Margin="0,0,12,0" Background="{StaticResource InfoSoftBrush}">
                            <ui:SymbolIcon x:Name="iconForm" Symbol="Add24" FontSize="18"
                                           Foreground="{StaticResource InfoBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtFormTitle" Text="New grade" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="txtFormHint" Text="Enter the course and its three scores."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Course" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtCourse" PlaceholderText="e.g. Programming I" MaxLength="100"
                                Icon="{ui:SymbolIcon BookOpen24}" />

                    <UniformGrid Columns="3" Margin="-4,0,-4,0">
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Score 1" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox x:Name="nbScore1" PlaceholderText="0" MaxDecimalPlaces="2"
                                          SmallChange="1" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                          TextChanged="Score_TextChanged" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Score 2" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox x:Name="nbScore2" PlaceholderText="0" MaxDecimalPlaces="2"
                                          SmallChange="1" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                          TextChanged="Score_TextChanged" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Score 3" Style="{StaticResource FieldLabel}" />
                            <ui:NumberBox x:Name="nbScore3" PlaceholderText="0" MaxDecimalPlaces="2"
                                          SmallChange="1" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                          TextChanged="Score_TextChanged" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Vista previa: la calcula Negocio con IGradeService.Preview -->
                    <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8"
                            Background="{StaticResource NeutralSoftBrush}">
                        <Grid x:Name="previewPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Average (preview)" Style="{StaticResource HintText}" />
                                <TextBlock x:Name="txtPreviewAverage" Text="–" FontSize="24" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border x:Name="previewPill" Grid.Column="1" Style="{StaticResource StatusPill}"
                                    Visibility="Collapsed">
                                <TextBlock Style="{StaticResource StatusPillText}" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="txtRules" Margin="2,8,0,0" Style="{StaticResource HintText}" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnNew" Grid.Column="0" Content="New" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Add24}" ToolTip="Clear the form (Ctrl+N)"
                                   Click="btnNew_Click" />
                        <ui:Button x:Name="btnSave" Grid.Column="2" Content="Save" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" ToolTip="Save (Ctrl+S)"
                                   Click="btnSave_Click" />
                    </Grid>
                    <ui:Button x:Name="btnDelete" Content="Delete grade" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Click="btnDelete_Click" />

                    <TextBlock Margin="0,20,0,0" Style="{StaticResource HintText}"
                               Text="Tip: Ctrl+N new · Ctrl+S save · Esc cancel editing" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
