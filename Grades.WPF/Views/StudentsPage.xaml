<Page x:Class="Grades.WPF.Views.StudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Students"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Students" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Register, search and manage students. Averages are calculated from their grades."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Tarjetas de resumen (vienen de IStudentService.GetSummary) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,20">
            <ui:Card Margin="6" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource InfoSoftBrush}">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="22" Foreground="{StaticResource InfoBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total students" Style="{StaticResource HintText}" />
                        <TextBlock x:Name="txtTotal" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource SuccessSoftBrush}">
                        <ui:SymbolIcon Symbol="Trophy24" FontSize="22" Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Approved" Style="{StaticResource HintText}" />
                        <TextBlock x:Name="txtApproved" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource DangerSoftBrush}">
                        <ui:SymbolIcon Symbol="DismissCircle24" FontSize="22" Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Failed" Style="{StaticResource HintText}" />
                        <TextBlock x:Name="txtFailed" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconBadge}" Background="{StaticResource WarningSoftBrush}">
                        <ui:SymbolIcon Symbol="DataTrending24" FontSize="22" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Overall average" Style="{StaticResource HintText}" />
                        <TextBlock x:Name="txtAverage" Text="–" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista de estudiantes -->
            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="txtSearch" Grid.Column="0" Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Search by code, first name or last name…"
                                    ClearButtonEnabled="True" TextChanged="txtSearch_TextChanged" />
                        <ui:Button x:Name="btnRefresh" Grid.Column="1" Margin="8,0,0,0" Padding="10"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh"
                                   Click="btnRefresh_Click" />
                    </Grid>

                    <DataGrid x:Name="dgStudents" Grid.Row="1" Style="{StaticResource ModernGrid}"
                              SelectionChanged="dgStudents_SelectionChanged"
                              MouseDoubleClick="dgStudents_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="3*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="Average" Binding="{Binding OverallAverage, StringFormat=0.00}"
                                                Width="84" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}">
                                            <TextBlock Style="{StaticResource StatusPillText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío -->
                    <StackPanel x:Name="emptyState" Grid.Row="1" Style="{StaticResource EmptyState}">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="txtEmpty" Text="No students found." Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <!-- Indicador de carga -->
                    <ui:ProgressRing x:Name="busyRing" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>

            <!-- Formulario: registrar o editar -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="8"
                                Margin="0,0,12,0" Background="{StaticResource InfoSoftBrush}">
                            <ui:SymbolIcon x:Name="iconForm" Symbol="PersonAdd24" FontSize="18"
                                           Foreground="{StaticResource InfoBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtFormTitle" Text="New student" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="txtFormHint" Text="Fill in the data and press Save."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Code" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtCode" PlaceholderText="e.g. U2024004" MaxLength="10"
                                CharacterCasing="Upper" />

                    <TextBlock Text="First name" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtFirstName" PlaceholderText="e.g. María" MaxLength="50" />

                    <TextBlock Text="Last name" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtLastName" PlaceholderText="e.g. Quispe" MaxLength="50" />

                    <TextBlock Text="Email (optional)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox x:Name="txtEmail" PlaceholderText="name@mail.com" MaxLength="100"
                                Icon="{ui:SymbolIcon Mail24}" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnNew" Grid.Column="0" Content="New" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Add24}" ToolTip="Clear the form (Ctrl+N)"
                                   Click="btnNew_Click" />
                        <ui:Button x:Name="btnSave" Grid.Column="2" Content="Save" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" ToolTip="Save (Ctrl+S)"
                                   Click="btnSave_Click" />
                    </Grid>

                    <ui:Button x:Name="btnViewGrades" Content="View grades" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Notebook24}"
                               ToolTip="Open the grades of this student (double-click a row)"
                               Click="btnViewGrades_Click" />
                    <ui:Button x:Name="btnDelete" Content="Delete student" Margin="0,8,0,0"
                               HorizontalAlignment="Stretch" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                               Click="btnDelete_Click" />

                    <TextBlock Margin="0,20,0,0" Style="{StaticResource HintText}"
                               Text="Tip: Ctrl+N new · Ctrl+S save · Esc cancel editing" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
