<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Ajusta el servidor según tu instalación (., localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB) -->
    <add name="DB"
         connectionString="Server=.\SQLEXPRESS;Database=GradesDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Parámetros del negocio. Se leen en Grades.Business/BusinessSettings.cs.
         Se pueden cambiar sin recompilar. Usar punto como separador decimal (ej. 10.5). -->
    <add key="MinScore" value="0" />
    <add key="MaxScore" value="20" />
    <add key="PassingScore" value="13" />
  </appSettings>
</configuration>
